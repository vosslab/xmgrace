# Example for the Grace browser app.
@version 50125
@g0 on
@g0 type XY
@with g0
@    world 0, 0, 6, 10
@    title "Calibration measurements"
@    xaxis label "Concentration (mM)"
@    xaxis tick major 1
@    yaxis label "Signal (arbitrary units)"
@    yaxis tick major 2
@    s0 type xydy
@    s0 line type 0
@    s0 symbol 3
@    s0 symbol color 4
@    s0 errorbar on
@    s0 errorbar color 4
@target G0.S0
@type xydy
1 1.7 0.4
2 3.5 0.5
3 5.3 0.3
4 6.8 0.6
5 8.4 0.4
&
